<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Capture analysis through the Z-bit web site is only built in when ZBitAnalysisSiteUrl, ZBitAnalysisAuthority and
    ZBitAnalysisClientId are set: in ZBitAnalysis.local.props at the repository root (git-ignored; see
    ZBitAnalysis.local.props.example), as environment variables, or with -p: on the command line. Without them the
    app has no capture analysis.
  -->
  <Import Project="..\..\..\ZBitAnalysis.local.props" Condition="Exists('..\..\..\ZBitAnalysis.local.props')" />

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Platforms>AnyCPU;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Logo.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>True</UseWPF>
    <AssemblyName>OSDPBench</AssemblyName>
    <RootNamespace>OSDPBench.Windows</RootNamespace>
    <StartupObject>OSDPBench.Windows.App</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="System.Management" Version="10.0.13" />
    <PackageReference Include="Markdig" Version="1.5.0" />
    <PackageReference Update="Microsoft.SourceLink.GitHub" Version="10.0.402" />
  </ItemGroup>

  <ItemGroup Condition="'$(ZBitAnalysisSiteUrl)' != '' And '$(ZBitAnalysisAuthority)' != '' And '$(ZBitAnalysisClientId)' != ''">
    <AssemblyMetadata Include="ZBitAnalysis.SiteUrl" Value="$(ZBitAnalysisSiteUrl)" />
    <AssemblyMetadata Include="ZBitAnalysis.Authority" Value="$(ZBitAnalysisAuthority)" />
    <AssemblyMetadata Include="ZBitAnalysis.ClientId" Value="$(ZBitAnalysisClientId)" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Assets\Apache.txt" />
    <None Remove="Assets\logo.png" />
    <None Remove="Assets\MIT.txt" />
    <None Remove="Assets\osdpbench-icon.png" />
    <None Remove="Logo.ico" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\Apache.txt" />
    <Resource Include="Assets\logo.png" />
    <Resource Include="Assets\MIT.txt" />
    <Resource Include="Assets\osdpbench-icon.png" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Logo.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\Core.csproj" />
    <ProjectReference Include="..\..\CaptureAnalysis.ZBit\CaptureAnalysis.ZBit.csproj" />
    <ProjectReference Include="..\..\..\lib\Guidelines\src\ZBitSystems.Wpf.UI\ZBitSystems.Wpf.UI.csproj" />
  </ItemGroup>


  <ItemGroup>
    <Page Update="Views\Controls\MonitorKeypadReadsControl.xaml">
      <Generator>MSBuild:Compile</Generator>
      <XamlRuntime>Wpf</XamlRuntime>
      <SubType>Designer</SubType>
    </Page>
    <Page Update="Views\Controls\ControlBuzzerControl.xaml">
      <Generator>MSBuild:Compile</Generator>
      <XamlRuntime>Wpf</XamlRuntime>
      <SubType>Designer</SubType>
    </Page>
  </ItemGroup>
</Project>
