<ui:FluentWindow x:Class="OSDPBench.Windows.Views.Windows.CaptureAnalysisWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:OSDPBench.Windows.Views.Windows"
        xmlns:models="clr-namespace:OSDPBench.Core.Models;assembly=OSDPBench.Core"
        xmlns:helpers="clr-namespace:OSDPBench.Windows.Helpers"
        xmlns:converters="clr-namespace:ZBitSystems.Wpf.UI.Converters;assembly=ZBitSystems.Wpf.UI"
        xmlns:localization="clr-namespace:ZBitSystems.Wpf.UI.Localization;assembly=ZBitSystems.Wpf.UI"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance local:CaptureAnalysisWindow, IsDesignTimeCreatable=False}"
        Title="{localization:Localize CaptureAnalysis_Title}"
        ExtendsContentIntoTitleBar="True"
        WindowCornerPreference="Round"
        WindowStartupLocation="CenterOwner"
        Width="780" Height="820"
        MinWidth="420" MinHeight="400">

    <ui:FluentWindow.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <DataTemplate x:Key="ExchangeTemplate" DataType="{x:Type models:CaptureAnalysisExchange}">
            <ui:Card Style="{StaticResource Card.Standard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Text.Subtitle}"
                               TextWrapping="Wrap"
                               Margin="0 0 0 8"
                               Text="{Binding Question}"
                               Visibility="{Binding HasQuestion, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <ui:ProgressRing IsIndeterminate="True"
                                     HorizontalAlignment="Left"
                                     Width="20" Height="20"
                                     Visibility="{Binding IsInProgress, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <RichTextBox IsReadOnly="True"
                                 IsDocumentEnabled="True"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0"
                                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                 VerticalScrollBarVisibility="Disabled"
                                 helpers:MarkdownDocument.Markdown="{Binding Answer}" />
                    <TextBlock Style="{StaticResource Text.Warning}"
                               TextWrapping="Wrap"
                               Margin="0 8 0 0"
                               Text="{localization:Localize CaptureAnalysis_AnswerTruncated}"
                               Visibility="{Binding IsTruncated, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    <TextBlock Style="{StaticResource Text.Caption}"
                               TextWrapping="Wrap"
                               Margin="0 8 0 0"
                               Text="{localization:Localize CaptureAnalysis_AnswerStopped}"
                               Visibility="{Binding WasStopped, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
            </ui:Card>
        </DataTemplate>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{localization:Localize CaptureAnalysis_Title}">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/OSDPBench;component/Assets/osdpbench-icon.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <ScrollViewer Grid.Row="1" x:Name="ReportScrollViewer" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="{StaticResource Margin.Card}">

                <!-- Capture and account -->
                <ui:Card Style="{StaticResource Card.Standard}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding ViewModel.ServiceName}" />
                        <TextBlock Style="{StaticResource Text.Subtitle}" TextWrapping="Wrap">
                            <Run Text="{localization:Localize CaptureAnalysis_CaptureLabel}" /><Run Text=": " /><Run Text="{Binding ViewModel.FileName, Mode=OneWay}" />
                        </TextBlock>

                        <WrapPanel Margin="{StaticResource Margin.Control}"
                                   Visibility="{Binding ViewModel.ShowSignInPrompt, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Style="{StaticResource Text.Body}"
                                       VerticalAlignment="Center"
                                       Margin="0 0 12 0"
                                       Text="{localization:Localize CaptureAnalysis_SignInPrompt}" />
                            <ui:Button x:Name="SignInButton"
                                       Style="{StaticResource Button.Primary}"
                                       Content="{localization:Localize CaptureAnalysis_SignIn}"
                                       Command="{Binding ViewModel.SignInCommand}">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="Person24" />
                                </ui:Button.Icon>
                            </ui:Button>
                        </WrapPanel>

                        <WrapPanel Margin="{StaticResource Margin.Control}"
                                   Visibility="{Binding ViewModel.IsSigningIn, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <ui:ProgressRing IsIndeterminate="True"
                                             VerticalAlignment="Center"
                                             Margin="0 0 12 0"
                                             Width="20" Height="20" />
                            <TextBlock Style="{StaticResource Text.Body}"
                                       VerticalAlignment="Center"
                                       Margin="0 0 12 0"
                                       Text="{localization:Localize CaptureAnalysis_WaitingForSignIn}" />
                            <ui:Button x:Name="CancelSignInButton"
                                       Style="{StaticResource Button.Secondary}"
                                       Content="{localization:Localize Common_Cancel}"
                                       Command="{Binding ViewModel.StopCommand}" />
                        </WrapPanel>

                        <WrapPanel Margin="{StaticResource Margin.Control}"
                                   Visibility="{Binding ViewModel.IsSignedIn, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Style="{StaticResource Text.Body}"
                                       VerticalAlignment="Center"
                                       Margin="0 0 12 0"
                                       Text="{Binding ViewModel.AccountText}" />
                            <TextBlock Style="{StaticResource Text.Caption}"
                                       VerticalAlignment="Center"
                                       Margin="0 0 12 0"
                                       Text="{Binding ViewModel.QuotaText}" />
                            <ui:Button x:Name="SignOutButton"
                                       Style="{StaticResource Button.Transparent}"
                                       Content="{localization:Localize CaptureAnalysis_SignOut}"
                                       Command="{Binding ViewModel.SignOutCommand}" />
                        </WrapPanel>
                    </StackPanel>
                </ui:Card>

                <!-- Options -->
                <ui:Card Style="{StaticResource Card.Standard}">
                    <StackPanel>
                        <ui:TextBox x:Name="QuestionTextBox"
                                    PlaceholderText="{localization:Localize CaptureAnalysis_QuestionPlaceholder}"
                                    Text="{Binding ViewModel.Question, UpdateSourceTrigger=PropertyChanged}"
                                    TextWrapping="Wrap"
                                    AcceptsReturn="True"
                                    MaxLength="2000"
                                    MinHeight="60" />
                        <CheckBox Margin="{StaticResource Margin.Control}"
                                  Content="{localization:Localize CaptureAnalysis_IncludeKey}"
                                  IsChecked="{Binding ViewModel.IncludeSecureChannelKey}"
                                  Visibility="{Binding ViewModel.HasSecureChannelKey, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <CheckBox Margin="{StaticResource Margin.Control}"
                                  Content="{localization:Localize CaptureAnalysis_IncludeCredentials}"
                                  IsChecked="{Binding ViewModel.IncludeCredentials}" />

                        <WrapPanel Margin="{StaticResource Margin.Control}">
                            <ui:Button x:Name="AnalyzeButton"
                                       Style="{StaticResource Button.Primary}"
                                       Content="{localization:Localize CaptureAnalysis_Analyze}"
                                       Command="{Binding ViewModel.AnalyzeCommand}">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="DocumentSearch24" />
                                </ui:Button.Icon>
                            </ui:Button>
                            <ui:Button x:Name="StopButton"
                                       Style="{StaticResource Button.Secondary}"
                                       Content="{localization:Localize CaptureAnalysis_Stop}"
                                       Command="{Binding ViewModel.StopCommand}"
                                       Visibility="{Binding ViewModel.IsWorking, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="Stop24" />
                                </ui:Button.Icon>
                            </ui:Button>
                            <TextBlock Style="{StaticResource Text.Caption}"
                                       VerticalAlignment="Center"
                                       Text="{localization:Localize CaptureAnalysis_Working}"
                                       Visibility="{Binding ViewModel.IsWorking, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </WrapPanel>
                    </StackPanel>
                </ui:Card>

                <ui:InfoBar Severity="Error"
                            IsOpen="True"
                            IsClosable="False"
                            Margin="{StaticResource Margin.Card}"
                            Message="{Binding ViewModel.ErrorMessage}"
                            Visibility="{Binding ViewModel.HasError, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <!-- What the analyzer read -->
                <StackPanel Margin="{StaticResource Margin.Card}"
                            Visibility="{Binding ViewModel.HasSummary, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Style="{StaticResource Text.Body}" Text="{Binding ViewModel.SummaryText}" />
                    <TextBlock Style="{StaticResource Text.Caption}" TextWrapping="Wrap" Text="{Binding ViewModel.ChecksText}" />
                    <TextBlock Style="{StaticResource Text.Warning}"
                               TextWrapping="Wrap"
                               Text="{localization:Localize CaptureAnalysis_CaptureTruncated}"
                               Visibility="{Binding ViewModel.IsCaptureTruncated, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>

                <!-- Report and follow-ups -->
                <ItemsControl x:Name="ExchangesItemsControl"
                              ItemsSource="{Binding ViewModel.Exchanges}"
                              ItemTemplate="{StaticResource ExchangeTemplate}" />
            </StackPanel>
        </ScrollViewer>

        <!-- Follow-up question -->
        <Grid Grid.Row="2"
              Margin="{StaticResource Margin.Card}"
              Visibility="{Binding ViewModel.CanAskFollowUp, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBox x:Name="FollowUpTextBox"
                        Grid.Column="0"
                        PlaceholderText="{localization:Localize CaptureAnalysis_FollowUpPlaceholder}"
                        Text="{Binding ViewModel.FollowUpQuestion, UpdateSourceTrigger=PropertyChanged}"
                        MaxLength="2000">
                <ui:TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding ViewModel.AskCommand}" />
                </ui:TextBox.InputBindings>
            </ui:TextBox>
            <ui:Button x:Name="AskButton"
                       Grid.Column="1"
                       Style="{StaticResource Button.Primary}"
                       Margin="8 0 0 0"
                       Content="{localization:Localize CaptureAnalysis_Ask}"
                       Command="{Binding ViewModel.AskCommand}">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="Send24" />
                </ui:Button.Icon>
            </ui:Button>
        </Grid>
    </Grid>
</ui:FluentWindow>
