<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                    xmlns:controls="clr-namespace:OSDPBench.Windows.Views.Controls"
                    xmlns:localization="clr-namespace:ZBitSystems.Wpf.UI.Localization;assembly=ZBitSystems.Wpf.UI"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" mc:Ignorable="d">

    <!-- DesignTokens and ComponentStyles are loaded via App.xaml from Guidelines library -->

    <!-- Connection Status Style -->
    <Style x:Key="ConnectionStatusText" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Visibility" Value="Collapsed"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Path=ViewModel.StatusLevel}" Value="Connected">
                <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Page Header Template -->
    <ControlTemplate x:Key="Template.PageHeader" TargetType="ContentControl">
        <StackPanel Margin="{StaticResource Margin.Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <!-- Page Title -->
                <TextBlock Grid.Column="0"
                           Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Content}"
                           Style="{StaticResource Page.Title}"
                           VerticalAlignment="Center"/>
                
                <!-- Status Container -->
                <Border Grid.Column="1"
                        Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource CornerRadius.Small}"
                        Padding="12,6"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right">
                    <WrapPanel Orientation="Horizontal">
                        <!-- Connection Status - Active Mode (Address at BaudRate) -->
                        <TextBlock Style="{StaticResource ConnectionStatusText}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,16,0"
                                   Text="{localization:LocalizeFormat Status_ConnectionFormat, Paths='ViewModel.ConnectedAddress,ViewModel.ConnectedBaudRate'}" />

                        <!-- Connection Status - Passive Monitoring (BaudRate only) -->
                        <TextBlock VerticalAlignment="Center"
                                   Margin="0,0,16,0"
                                   FontWeight="Bold"
                                   Text="{localization:LocalizeFormat Status_PassiveMonitoringFormat, Paths=ViewModel.ConnectedBaudRate}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Path=ViewModel.StatusLevel}" Value="PassiveMonitoring">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Security Status Badges -->
                        <!-- Clear Text (Red outlined) - shown when connected and not using secure channel -->
                        <Border Margin="0,0,16,0">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource Badge.Error.Outlined}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding Path=ViewModel.StatusLevel}" Value="Connected"/>
                                                <Condition Binding="{Binding Path=ViewModel.UsingSecureChannel}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{localization:Localize Monitor_ClearText}"
                                       Style="{StaticResource Badge.Text.Error}"/>
                        </Border>

                        <!-- Encrypted - Default Key (Red outlined) - shown when connected with secure channel using default key -->
                        <Border Margin="0,0,16,0">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource Badge.Error.Outlined}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding Path=ViewModel.StatusLevel}" Value="Connected"/>
                                                <Condition Binding="{Binding Path=ViewModel.UsingSecureChannel}" Value="True"/>
                                                <Condition Binding="{Binding Path=ViewModel.UsesDefaultSecurityKey}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{localization:Localize Monitor_EncryptedDefaultKey}"
                                       Style="{StaticResource Badge.Text.Error}"/>
                        </Border>

                        <!-- Encrypted (Green) - shown when connected with secure channel using custom key -->
                        <Border Margin="0,0,16,0">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource Badge.Success}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding Path=ViewModel.StatusLevel}" Value="Connected"/>
                                                <Condition Binding="{Binding Path=ViewModel.UsingSecureChannel}" Value="True"/>
                                                <Condition Binding="{Binding Path=ViewModel.UsesDefaultSecurityKey}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{localization:Localize Monitor_Encrypted}"
                                       Style="{StaticResource Badge.Text}"/>
                        </Border>

                        <!-- Monitor (Blue) - shown when in passive monitoring mode -->
                        <Border Margin="0,0,16,0">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource Badge.Info}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Path=ViewModel.StatusLevel}" Value="PassiveMonitoring">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{localization:Localize Monitor_PassiveMonitoring}"
                                       Style="{StaticResource Badge.Text}"/>
                        </Border>

                        <!-- TX Activity Indicator -->
                        <StackPanel Style="{StaticResource Activity.Container}">
                            <TextBlock Text="{localization:Localize Activity_Tx}" 
                                       Style="{StaticResource Activity.Label}"
                                       FontWeight="Bold"/>
                            <controls:LedControl LastActivityTime="{Binding Path=ViewModel.LastTxActiveTime}" 
                                                 LedColor="Red" 
                                                 VerticalAlignment="Center"/>
                        </StackPanel>
                        
                        <!-- RX Activity Indicator -->
                        <StackPanel Style="{StaticResource Activity.Container}"
                                    Margin="0">
                            <TextBlock Text="{localization:Localize Activity_Rx}" 
                                       Style="{StaticResource Activity.Label}"
                                       FontWeight="Bold"/>
                            <controls:LedControl LastActivityTime="{Binding Path=ViewModel.LastRxActiveTime}" 
                                                 LedColor="Red" 
                                                 VerticalAlignment="Center"/>
                        </StackPanel>
                    </WrapPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ControlTemplate>

    <!-- Form Field Template -->
    <ControlTemplate x:Key="Template.FormField" TargetType="ContentControl">
        <StackPanel Orientation="Vertical" Margin="{StaticResource Margin.Section}">
            <Label Content="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Tag}"
                   Style="{StaticResource Label.Standard}"
                   Target="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Content}"/>
            <ContentPresenter/>
        </StackPanel>
    </ControlTemplate>

    <!-- Status Message Template -->
    <DataTemplate x:Key="Template.StatusMessage">
        <TextBlock Text="{Binding StatusText}"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   HorizontalAlignment="Center"
                   Margin="16,0" d:DataContext="{d:DesignInstance }">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Headline}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding StatusLevel}" Value="Connected">
                            <Setter Property="Foreground" Value="{DynamicResource SemanticSuccessBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding StatusLevel}" Value="Error">
                            <Setter Property="Foreground" Value="{DynamicResource SemanticErrorBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding StatusLevel}" Value="Discovering">
                            <Setter Property="Foreground" Value="{DynamicResource SemanticInfoBrush}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding StatusLevel}" Value="Disconnected">
                            <Setter Property="Foreground" Value="{DynamicResource SemanticWarningBrush}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </DataTemplate>

    <!-- Card Section Template -->
    <Style x:Key="Style.CardSection" TargetType="ui:Card" BasedOn="{StaticResource Card.Standard}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ui:Card">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource CornerRadius.Medium}"
                            Padding="{TemplateBinding Padding}"
                            Margin="{TemplateBinding Margin}">
                        <ContentPresenter/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Data Grid Styles -->
    <Style x:Key="DataGrid.Standard" TargetType="DataGrid">
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="IsReadOnly" Value="True"/>
        <Setter Property="Margin" Value="{StaticResource Margin.Card}"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
    </Style>

    <Style x:Key="DataGrid.Monitor" TargetType="DataGrid" BasedOn="{StaticResource DataGrid.Standard}">
        <Setter Property="RowDetailsVisibilityMode" Value="Collapsed"/>
    </Style>

    <!-- Progress Bar Template -->
    <Style x:Key="ProgressBar.FileTransfer" TargetType="ProgressBar">
        <Setter Property="Height" Value="{StaticResource Control.Height.Medium}"/>
        <Setter Property="Maximum" Value="100"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
        <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlElevationBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <!-- Connection Type Section Template -->
    <Style x:Key="Style.ConnectionSection" TargetType="Grid">
        <Setter Property="Margin" Value="0,0,0,16"/>
    </Style>

    <!--
        Compact inline action. Borderless and sized to caption text so bulk actions can sit on a
        section header row as text rather than as buttons competing with the primary button below.
    -->
    <Style x:Key="Button.Compact" TargetType="ui:Button" BasedOn="{StaticResource Button.Transparent}">
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Padding" Value="{StaticResource Padding.Control}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="FontSize" Value="{StaticResource FontSize.Caption}"/>
    </Style>

    <!--
        Checkable list, for a set of options expected to grow past what a row of check boxes can
        hold. The row carries the selection and the check box in the item template is only the
        indicator, so the hit area is a whole row rather than a glyph and the two can never
        disagree. A themed check box is only hit tested over the glyph and label it paints, so
        stretching one across the row would not widen the target.

        The stock row chrome is deliberately replaced rather than restyled: a themed list fills
        the whole row with the accent colour when an item is selected, which on a list where most
        items are usually checked reads as a solid block instead of a set of choices.

        Items must expose a two-way IsSelected property and a read-only AccessibleName: the row is
        what a screen reader lands on, and it would otherwise announce the item type name.
    -->
    <Style x:Key="ListBoxItem.CheckList" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
        <Setter Property="Padding" Value="{StaticResource Padding.Control}"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
        <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <!-- Transparent rather than unset: an unpainted row is not hit tested. -->
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Stretch"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ListBox.CheckList" TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
        <Setter Property="SelectionMode" Value="Multiple"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="MinWidth" Value="{StaticResource Control.Width.Small}"/>
        <!-- Tall enough for the six OSDP rates; a seventh option starts it scrolling. -->
        <Setter Property="MaxHeight" Value="270"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource ListBoxItem.CheckList}"/>
    </Style>

    <!--
        Tag input: a box that reads as a text field but holds the current choices as removable
        tags, with a picker for everything else. Used where the option list is long enough that a
        row of check boxes would dominate the page, and where what matters at a glance is what has
        been chosen rather than what is on offer.
    -->
    <Style x:Key="TagInput.Container" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlElevationBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadius.Small}"/>
        <Setter Property="Padding" Value="{StaticResource Padding.Control}"/>
        <Setter Property="MinHeight" Value="{StaticResource Control.Height.Large}"/>
    </Style>

    <Style x:Key="Tag.Container" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadius.Medium}"/>
        <Setter Property="Padding" Value="8,1"/>
        <Setter Property="Margin" Value="0,2,6,2"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="Tag.Text" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- The tag's own remove affordance, kept small enough not to outweigh the tag holding it. -->
    <Style x:Key="Tag.Remove" TargetType="ui:Button" BasedOn="{StaticResource Button.Compact}">
        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
        <Setter Property="Padding" Value="2,0"/>
        <Setter Property="Margin" Value="4,0,-4,0"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="TagInput.Placeholder" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="2,0,0,0"/>
    </Style>

    <!--
        Surface for content that floats above the page. A popup is not inside the page's visual
        ground, so it has to carry its own background and edge or it renders over whatever
        happens to be behind it.
    -->
    <Style x:Key="Popup.Surface" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource ApplicationBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ControlElevationBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource CornerRadius.Medium}"/>
        <Setter Property="Padding" Value="{StaticResource Thickness.Small}"/>
    </Style>

</ResourceDictionary>

